{
  "version": 2,
  "buildCommand": "pnpm run vercel-build || npm run vercel-build",
  "env": {
    "NODE_OPTIONS": "--experimental-require-module"
  },
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
